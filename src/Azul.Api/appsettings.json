{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "RateLimit": { "SignupPerHour": 5, "PublicPerMinute": 300, "SearchPerMinute": 60 },
  "Session": { "ExpireDays": 14, "SecurityStampCheckMinutes": 5 },
  "AllowedHosts": "*"
}
