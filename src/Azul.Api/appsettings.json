{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/azul-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RateLimit": { "AdminLoginPerMinute": 5, "SignupPerHour": 5 },
  "AllowedHosts": "*"
}
